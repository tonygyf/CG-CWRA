# Host paths and runtime toggles used by docker/docker-compose.yml. Keep real
# values in .env.
BASE_IMAGE=python:3.11-slim
HOST_DATA_DIR=../data
HOST_CHECKPOINT_DIR=../artifacts/checkpoints
HOST_PRETRAINED_DIR=../artifacts/pretrained
HOST_HF_CACHE_DIR=../artifacts/hf_cache
HOST_OUTPUTS_DIR=../outputs
HOST_REPORTS_DIR=../reports
TOKENIZERS_PARALLELISM=false
WANDB_API_KEY=
