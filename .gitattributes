# Auto detect text files and perform LF normalization
* text=auto

# Scripts and configuration must retain Unix-compatible line endings on servers.
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Keep heavyweight binary artifacts out of textual diffs if explicitly committed.
*.pt binary
*.pth binary
*.safetensors binary
*.ckpt binary
