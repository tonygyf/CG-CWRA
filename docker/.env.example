# .env.example
# Copy this file to .env and adjust the values according to your host environment

# Host directories for large files to avoid storing them in the repository
HOST_DATA_DIR=../data
HOST_CHECKPOINT_DIR=../artifacts/checkpoints
HOST_PRETRAINED_DIR=../artifacts/pretrained
HOST_HF_CACHE_DIR=../artifacts/hf_cache
HOST_OUTPUTS_DIR=../outputs

# Weights & Biases API Key (Optional)
WANDB_API_KEY=your_wandb_api_key_here
